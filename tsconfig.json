{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "paths": {
      "@/*":["./src/*"],
      "#/*":["./generated/prisma/*"]
    },
    "types": ["jest"],
    "isolatedModules": true,
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "generated/**/*.ts"],
  "exclude": ["dist"]
}
